{
  "name": "automation-testing",
  "version": "1.0.0",
  "description": "End-to-end automation testing framework using Playwright and TypeScript for UI and API testing with hybrid architecture.",
  "author": "Viktoriia Markus",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test tests/api",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^25.6.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
